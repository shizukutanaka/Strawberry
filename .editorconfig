# EditorConfig — consistent formatting across editors/IDEs.
# Complements .gitattributes (line endings on checkout) and eslint.config.mjs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks — don't strip.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

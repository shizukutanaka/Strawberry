# Strawberry 環境変数サンプル
# 本番環境では JWT_SECRET / ENCRYPTION_KEY / SESSION_SECRET は必須。
# 未設定の場合、本番(NODE_ENV=production)では起動に失敗します(fail-fast)。
# 開発時に未設定なら、プロセス起動ごとにランダムな一時シークレットが生成されます。

# 実行環境
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api/v1
# カンマ区切り。'*' は全許可(本番非推奨)
CORS_ORIGINS=*

# --- セキュリティ（必須シークレット。16文字以上を推奨）---
JWT_SECRET=
# アクセストークンの有効期限（短命運用なら 15m〜1h を推奨）
JWT_EXPIRES_IN=24h
# リフレッシュトークンの有効期限（POST /users/refresh で新アクセストークンを発行）
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
SESSION_SECRET=
# マシン間通信用APIキー（任意。設定時のみ x-api-key 認証が有効）
API_KEY=
BCRYPT_ROUNDS=12

# --- Google OAuth（マスター3重認証。未設定なら /master-auth/google は503）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MASTER_GOOGLE_EMAIL=
MASTER_TOTP_SECRET=

# --- Lightning Network / Bitcoin ---
BITCOIN_NETWORK=testnet
LND_HOST=127.0.0.1:10009
LND_CERT_PATH=
LND_MACAROON_PATH=
# 運営手数料率（例: 0.015 = 1.5%）
BTC_FEE_RATE=0.015

# --- 為替レート ---
# 上流の為替 API が全滅したあと、再挑戦するまでの冷却時間（ms、既定 30000）。
# 冷却が無いと、上流障害中に**全リクエスト**が 4 本の API を順に叩いて
# タイムアウトを待つ（＝障害が「全体が遅い」に増幅される）。
EXCHANGE_RATE_COOLDOWN_MS=

# --- 収益台帳・出金（src/payments/payout-ledger.js）---
# 完了注文の収益をプロバイダへ計上する掃き出しジョブの間隔（ms、既定 300000 = 5 分）。
EARNINGS_SWEEP_INTERVAL_MS=
# 出金申請の最低額（sats、既定 1000）。少額出金は送金手数料・運用手間に見合わない。
PAYOUT_MIN_SATS=

# --- ログ ---
LOG_LEVEL=info

# --- 監査ログの外部アンカリング（研究ドキュメント §18）---
# 監査ログの Merkle root を定期生成し、OpenTimestamps へ提出して非否認性を確立する。
# root の生成・公開は常時有効。外部への提出だけが下のフラグでオプトイン（既定は無効）。
AUDIT_ANCHOR_OTS_ENABLED=
# アンカー生成の間隔（ms、既定 3600000 = 1 時間）。短くするほど「まだアンカーされていない窓」が狭まる。
AUDIT_ANCHOR_INTERVAL_MS=
# 提出先カレンダー（カンマ区切り。未設定なら OpenTimestamps 公開プールへ冗長提出）。
# 単一カレンダー運営者と結託されると外部アンカリングの意味が消えるため、複数指定すること。
AUDIT_ANCHOR_CALENDARS=
AUDIT_ANCHOR_OTS_TIMEOUT_MS=
# 保存先（未設定なら logs/audit-anchors.jsonl と logs/audit-anchors-receipts.jsonl）
AUDIT_ANCHOR_PATH=
AUDIT_ANCHOR_RECEIPT_PATH=
# ハッシュ連鎖付き監査ログ本体の移動先（src/utils/audit-log.js）
AUDIT_LOG_PATH=
AUDIT_HASH_PATH=
# HTTP アクセス監査の移動先（src/api/middleware/audit.js）。
# 上の AUDIT_LOG_PATH とは必ず別ファイルにすること（同一にするとハッシュ連鎖に含まれない
# エントリが挟まり、改ざん検知とアンカー検証が常に失敗する）。
ACCESS_AUDIT_LOG_PATH=

# --- 外部通知（任意）---
SLACK_WEBHOOK=
DISCORD_WEBHOOK=
LINE_TOKEN=
SENTRY_DSN=

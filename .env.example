# Strawberry 環境変数サンプル
# 本番環境では JWT_SECRET / SESSION_SECRET は必須。
# 未設定の場合、本番(NODE_ENV=production)では起動に失敗します(fail-fast)。
# 開発時に未設定なら、プロセス起動ごとにランダムな一時シークレットが生成されます。

# 実行環境
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api/v1
# カンマ区切り。'*' は全許可(本番非推奨)
CORS_ORIGINS=*

# --- セキュリティ（必須シークレット。16文字以上を推奨）---
JWT_SECRET=
# アクセストークンの有効期限（短命運用なら 15m〜1h を推奨）
JWT_EXPIRES_IN=24h
# リフレッシュトークンの有効期限（POST /users/refresh で新アクセストークンを発行）
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=
BCRYPT_ROUNDS=12

# --- Google OAuth（マスター3重認証。未設定なら /master-auth/google は503）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MASTER_GOOGLE_EMAIL=
MASTER_TOTP_SECRET=

# --- Lightning Network / Bitcoin ---
BITCOIN_NETWORK=testnet
LND_HOST=127.0.0.1:10009
LND_CERT_PATH=
LND_MACAROON_PATH=
# 運営手数料率（例: 0.015 = 1.5%）
BTC_FEE_RATE=0.015

# --- ログ ---
LOG_LEVEL=info

# --- 外部通知（任意）---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK=
LINE_TOKEN=
# --- オプション環境変数（運用調整用・全て省略可）---
# 監査: AUDIT_LOG_PATH, AUDIT_HASH_PATH, AUDIT_LOG_FORCE_REPAIR, MAX_AUDIT_LOG_MB
# 認証/レート制限: JWT_REFRESH_SECRET, AUTH_RATE_LIMIT_MAX, RATE_LIMIT_MAX, TRUST_PROXY
# 注文タイムアウト: ORDER_PENDING_TIMEOUT_MINUTES, ORDER_MATCHED_TIMEOUT_MINUTES,
#   ORDER_ACTIVE_TIMEOUT_HOURS, ORDER_DISPUTE_TIMEOUT_DAYS, ORDER_CREATE_RATE_LIMIT
# 係争ゲート: MIN_RESOLVED_DISPUTES, MAX_DENIED_DISPUTE_RATE, MAX_OPEN_DISPUTES_PER_USER,
#   AUTO_DISPUTE_DECISION
# GPU: MAX_GPUS_PER_PROVIDER, HEARTBEAT_MIN_INTERVAL_MS, SLA_PROVIDER_HEARTBEAT_TIMEOUT_MS,
#   UPTIME_MIN_BEATS, UPTIME_GAP_THRESHOLD_MS, UPTIME_BREACH_PENALTY
# Lightning API 送出し: LN_PROVIDER, LN_BASE_URL, LN_API_KEY, LND_PROTO_PATH
# メール通知: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SENDGRID_API_KEY,
#   SENDGRID_FROM, MAILGUN_API_KEY, MAILGUN_DOMAIN, EMAIL_FROM, MASTER_EMAIL_FROM
# 通知先 webhook: GENERIC_WEBHOOK, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# 監視/メトリクス: SERVICE_MONITOR_INTERVAL_MS, METRICS_AUTH_TOKEN
# OpenTelemetry（設定時のみ有効）: OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME
# E2E/テスト: E2E_BASE_URL, PLAYWRIGHT_CHROMIUM_PATH
# セキュリティ例外: SSRF_ALLOW_PRIVATE_WEBHOOKS

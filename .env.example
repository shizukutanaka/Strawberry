# Strawberry 環境変数サンプル
# 本番環境では JWT_SECRET / ENCRYPTION_KEY / SESSION_SECRET は必須。
# 未設定の場合、本番(NODE_ENV=production)では起動に失敗します(fail-fast)。
# 開発時に未設定なら、プロセス起動ごとにランダムな一時シークレットが生成されます。

# 実行環境
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api/v1
# カンマ区切り。'*' は全許可(本番非推奨)
CORS_ORIGINS=*
# リバースプロキシ配下なら 'trust proxy' に渡す値（例: '1' or 'loopback'）
# 不正設定はレート制限・IP判定の信頼性を損なうため本番では明示を推奨
TRUST_PROXY=false
# P2P ノードポート(既定9090) / ブートストラップノード(JSON配列)
P2P_PORT=9090
P2P_BOOTSTRAP_NODES=[]

# --- セキュリティ（必須シークレット。16文字以上を推奨）---
JWT_SECRET=
# アクセストークンの有効期限（短命運用なら 15m〜1h を推奨）
JWT_EXPIRES_IN=1h
# リフレッシュトークンの有効期限（POST /users/refresh で新アクセストークンを発行）
JWT_REFRESH_EXPIRES_IN=7d
# リフレッシュ用に別シークレットを分けたい場合（未設定なら JWT_SECRET を共用）
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=
# マシン間通信用APIキー（任意。設定時のみ x-api-key 認証が有効）
API_KEY=
# bcrypt コスト係数（10-31。デフォルト10、12推奨）
BCRYPT_ROUNDS=12
# Prometheus /metrics エンドポイントの Bearer 認証（任意。未設定なら /metrics は公開）
METRICS_AUTH_TOKEN=
# GraphQL イントロスペクション有効化（'true' のみ有効。本番では推奨しない）
GRAPHQL_INTROSPECTION=false

# --- レート制限 ---
# グローバル API レート制限（リクエスト数/15分。デフォルト60、テスト時10000）
RATE_LIMIT_MAX=60
# 認証系エンドポイント（デフォルト10）
AUTH_RATE_LIMIT_MAX=10
# 注文作成（デフォルト10/ウィンドウ）
ORDER_CREATE_RATE_LIMIT=10

# --- Google OAuth / マスター3重認証（未設定なら /master-auth/google は503）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
MASTER_GOOGLE_EMAIL=
MASTER_TOTP_SECRET=
# マスター通知メール送信元（SMTP_* と併用）
MASTER_EMAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- Lightning Network / Bitcoin ---
BITCOIN_NETWORK=testnet
LND_HOST=127.0.0.1:10009
LND_CERT_PATH=
LND_MACAROON_PATH=
# LND 代替プロバイダ（'lnd' 既定。REST 系プロバイダは LN_BASE_URL/LN_API_KEY）
LN_PROVIDER=lnd
LN_BASE_URL=
LN_API_KEY=
# 運営手数料率（例: 0.015 = 1.5%）
BTC_FEE_RATE=0.015
# 注文の自動失効期限: pending(既定30分) / matched(既定60分) /
# active(既定48時間: 借り手が /stop せず GPU を占有し続ける防止) / disputed(既定7日)
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_MATCHED_TIMEOUT_MINUTES=60
ORDER_ACTIVE_TIMEOUT_HOURS=48
ORDER_DISPUTE_TIMEOUT_DAYS=7

# --- GPU / 実行環境 ---
# コード既定は vGPU=true / Docker=true / k8s=false。本番では要件に合わせて明示推奨
VIRTUAL_GPU_ENABLED=false
DOCKER_SUPPORT=false
KUBERNETES_SUPPORT=false
GPU_MIN_MEMORY_GB=4
GPU_SCAN_INTERVAL_MS=60000
# 1プロバイダあたりの出品上限
MAX_GPUS_PER_PROVIDER=50
# 貸し手 heartbeat の最小間隔(ms)。小さすぎると DoS・信頼性判定のノイズになる
HEARTBEAT_MIN_INTERVAL_MS=10000
# provider ハートビート途絶で SLA breach とみなすまでの閾値(ms)
SLA_PROVIDER_HEARTBEAT_TIMEOUT_MS=300000
# 同時 pending 注文の上限（1ユーザーあたり）
MAX_PENDING_ORDERS_PER_USER=50

# --- 係争・Sybil 対策 ---
# 係争敗訴率の上限（これを超えると出品停止等。デフォルト 0.67）
MAX_DENIED_DISPUTE_RATE=0.67
# 係争敗訴率の計算に必要な最小解決済み係争数
MIN_RESOLVED_DISPUTES=3
# 係争タイムアウト時の自動判定（既定 'refund'=借り手返金。'uphold'=提供者支持）
AUTO_DISPUTE_DECISION=refund
# 同時係争中の注文上限（1ユーザーあたり。デフォルト3）
MAX_OPEN_DISPUTES_PER_USER=3

# --- レピュテーション(稼働率) ---
# 稼働率計算で「ギャップ」とみなす heartbeat 間隔(ms)。最小30s
UPTIME_GAP_THRESHOLD_MS=60000
# 信頼性スコアを出すのに必要な最小 heartbeat 数
UPTIME_MIN_BEATS=20
# SLA ブリーチ1回あたりの信頼性減点率(0-1)
UPTIME_BREACH_PENALTY=0.2

# --- 監査ログ ---
AUDIT_LOG_PATH=data/audit.jsonl
AUDIT_HASH_PATH=data/audit.hash
# 監査ログローテーション閾値(MB)。超過でローテート
MAX_AUDIT_LOG_MB=50
# 起動時に監査ログの hash 鎖を強制修復するか(デバッグ用。通常は自動)
AUDIT_LOG_FORCE_REPAIR=false
# 監視対象・モニタログ出力先（service-monitor.js 用）
MONITOR_TARGETS=
MONITOR_LOG_PATH=logs/monitor.log
SERVICE_MONITOR_INTERVAL_MS=10000

# --- ログ ---
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
LOG_DIR=logs

# --- オブザーバビリティ ---
OTEL_SERVICE_NAME=strawberry
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- 外部通知（任意）---
SLACK_WEBHOOK=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK=
LINE_TOKEN=
LINE_NOTIFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=
GENERIC_WEBHOOK=
# プライベートIPへの webhook POST を許可(デフォルトfalse=SSRF対策で拒否)
SSRF_ALLOW_PRIVATE_WEBHOOKS=false
# メール通知（SMTP または汎用 API。マスター認証メール送信にも使用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_TO=
SENTRY_DSN=

# --- 外部連携スクリプト（任意・該当スクリプト使用時のみ）---
# Google Calendar 監視スクリプト（scripts/ で使用）
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REDIRECT_URI=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=
# S3 バックアップ連携（scripts/backup-*.js で使用）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# Dropbox / Google Drive / HuggingFace 連携スクリプト
DROPBOX_ACCESS_TOKEN=
GDRIVE_OAUTH_TOKEN=
HF_API_KEY=

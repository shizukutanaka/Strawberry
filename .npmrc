# Enforce the engines field (Node >=20) at install time so contributors on
# older Node versions get a clear error instead of subtle runtime breakage.
engine-strict=true

# Pin exact versions on `npm install <pkg>` — the repo's dependency history
# already assumes exact versions; floating ^ ranges made past audits noisier.
save-exact=true

# NOTE: `ignore-scripts` is deliberately NOT set — bcrypt and other native
# deps rely on install scripts (prebuild download) and would silently break.
